# Generated by running tests/tools locally -- never commit real or mock
# session data, matching root AGENTS.md's "no generated build outputs or
# real experiment data in commits" policy.
__pycache__/
*.pyc
.pytest_cache/
sessions/
outputs/
*.jsonl
*.jsonl.partial
*.recovered.jsonl
*.recovery_report.json

# tools/prepare_dataset.py outputs: the gzip archive, the Parquet working copy
# and its run log are all derived from sessions/ and equally uncommittable.
*.jsonl.gz
derived/
prepare_dataset.log
build_timeseries.log
raw_sessions_archive.zip
derived_dataset_archive.zip

# Data snapshots / archives -- experiment output, not code
*.zip
