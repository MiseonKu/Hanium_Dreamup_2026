{
  "schema_version": "1.0",
  "project": "01_Initial_Research_Archive",
  "purpose": "Offline-first research scaffold for three-IMU-per-link ShapeFK experiments.",
  "start_files": [
    "README.md",
    "AGENTS.md",
    "docs/AI_AGENT_GUIDE.md",
    "docs/CODE_MAP.md",
    "docs/DATA_CONTRACT.md",
    "docs/DECISION_LOG.md",
    "docs/OPTIMIZATION_AND_RANDOMIZATION.md",
    "docs/SO101_IK_REFERENCE.md",
    "docs/SIMULATION_INTEGRATION.md"
  ],
  "hard_rules": [
    "Tracker is ground truth only, never controller feedback.",
    "IMU-only means three-IMU ShapeFK, not acceleration double integration.",
    "Realtime IO belongs behind research_host/adapters.",
    "Real data under data/raw, data/processed, and data/analysis must not be committed.",
    "Position and attitude variables must include frame and unit suffixes.",
    "Parameter optimization must use validation split only.",
    "Randomized trial order must be generated from a recorded seed.",
    "Simulator support must remain export-only unless a separate integration package is added.",
    "Generated condition reports are descriptive and not inferential statistical proof."
  ],
  "operation_classes": {
    "safe_by_default": [
      "docs-only edits",
      "offline sample generation",
      "dataset validation on tracked samples",
      "unit tests",
      "dependency-free simulator exports",
      "dry-run simulator replay"
    ],
    "requires_explicit_user_intent": [
      "live sensor acquisition",
      "Tracker SDK integration",
      "realtime ST3215 control",
      "real trial data capture",
      "changing required data contract fields",
      "changing condition IDs",
      "changing reported optimization weights"
    ]
  },
  "task_routing": {
    "docs": [
      "README.md",
      "AGENTS.md",
      "docs/AI_AGENT_GUIDE.md",
      "docs/CODE_MAP.md"
    ],
    "data_contract": [
      "docs/DATA_CONTRACT.md",
      "host/research_host/logging.py",
      "host/research_host/cli/validate_dataset.py",
      "tests/test_logging_and_analysis.py",
      "tests/test_validate_dataset_cli.py"
    ],
    "shape_fk": [
      "host/research_host/shapefk.py",
      "host/research_host/math3d.py",
      "host/research_host/geometry.py",
      "tests/test_shapefk.py",
      "tests/test_math3d.py"
    ],
    "conditions_and_analysis": [
      "host/research_host/conditions.py",
      "host/research_host/analysis.py",
      "host/research_host/reports.py",
      "tests/test_conditions.py",
      "tests/test_reports.py"
    ],
    "randomization_and_optimization": [
      "host/research_host/experimental_design.py",
      "host/research_host/optimization.py",
      "configs/randomization_defaults.json",
      "configs/optimization_objective.json",
      "tests/test_experimental_design.py",
      "tests/test_optimization.py"
    ],
    "simulation": [
      "host/research_host/sim/exporters.py",
      "host/research_host/sim/replay.py",
      "docs/SIMULATION_INTEGRATION.md",
      "simulation/README.md",
      "tests/test_sim_exporters.py",
      "tests/test_sim_replay.py"
    ],
    "calibration_quality": [
      "host/research_host/calibration_contracts.py",
      "host/research_host/quality.py",
      "docs/CALIBRATION_GUIDE.md",
      "tests/test_calibration_contracts.py",
      "tests/test_quality.py"
    ]
  },
  "commands": {
    "doctor": "python -m research_host.cli.agent_doctor",
    "tests": "python -m pytest tests",
    "make_sample": "python -m research_host.cli.make_sample_trial --output .\\data\\samples",
    "validate_sample": "python -m research_host.cli.validate_dataset --metadata .\\data\\samples\\raw\\trial_0001_long_C2_imu_array_only_T001_rep01_2026-05-01_metadata.json --processed .\\data\\samples\\processed\\trial_0001_long_C2_imu_array_only_T001_rep01_2026-05-01_processed.csv",
    "generate_trial_plan": "python -m research_host.cli.generate_trial_plan --conditions C1,C2,C6,C7 --robot-models long,short --targets T001,T002 --repeats 1 --seed 101 --output .\\data\\samples\\trial_plan.csv --metadata-output .\\data\\samples\\trial_plan_metadata.json",
    "optimize_params": "python -m research_host.cli.optimize_params --input .\\data\\samples\\analysis\\optimization_candidates.csv --objective-config .\\configs\\optimization_objective.json --output .\\data\\samples\\analysis\\optimization_report.json",
    "export_sim_assets": "python -m research_host.cli.export_sim_assets --robot-model long --output .\\simulation\\generated",
    "summarize_quality": "python -m research_host.cli.summarize_quality --processed .\\data\\samples\\processed\\trial_0001_long_C2_imu_array_only_T001_rep01_2026-05-01_processed.csv",
    "mujoco_replay_dry_run": "python -m research_host.cli.replay_mujoco_trial --processed .\\data\\samples\\processed\\trial_0001_long_C2_imu_array_only_T001_rep01_2026-05-01_processed.csv --model .\\simulation\\generated\\mjcf\\so101_long.xml --dry-run",
    "compare_conditions": "python -m research_host.cli.compare_conditions --analysis .\\data\\samples\\analysis\\trial_0001_long_C2_imu_array_only_T001_rep01_2026-05-01_analysis.csv --processed .\\data\\samples\\processed\\trial_0001_long_C2_imu_array_only_T001_rep01_2026-05-01_processed.csv --output .\\data\\samples\\analysis\\condition_report.md"
  },
  "public_contract_files": [
    "host/research_host/logging.py",
    "host/research_host/experimental_design.py",
    "host/research_host/optimization.py",
    "host/research_host/quality.py",
    "host/research_host/calibration_contracts.py",
    "host/research_host/reports.py",
    "docs/DATA_CONTRACT.md",
    "configs/experiment_defaults.json",
    "configs/randomization_defaults.json",
    "configs/optimization_objective.json",
    "configs/ik_baseline.json",
    "configs/simulation_targets.json"
  ],
  "safe_extension_points": [
    "host/research_host/adapters",
    "host/research_host/analysis.py",
    "host/research_host/sim",
    "host/research_host/cli",
    "docs"
  ],
  "ask_before_changing": [
    "condition IDs",
    "required processed CSV columns",
    "metadata JSON required keys",
    "CSV + JSON as the required storage baseline",
    "Tracker feedback policy",
    "IMU-only definition",
    "optimization objective weights",
    "test split use for tuning",
    "IK solver use in realtime control",
    "simulator dependencies in offline tests",
    "adding real trial data to tracked fixtures"
  ],
  "reporting_contract": [
    "Docs changed.",
    "Code changed.",
    "Machine-readable context changed.",
    "Data contract changed or unchanged.",
    "Randomization/optimization policy changed or unchanged.",
    "Simulation assets or contracts changed or unchanged.",
    "Commands run and result.",
    "Known limitation."
  ]
}
