{
  "ik_baseline_version": "ik_v0.1",
  "recommended_solver": "damped_least_squares_numeric",
  "reference_implementations": [
    "LeRobot RobotKinematics with Placo and URDF",
    "local 6DOF NumericalIK6DOF damped least-squares solver"
  ],
  "default_parameters": {
    "max_iterations": 120,
    "position_tolerance_mm": 2.0,
    "orientation_tolerance_rad": 0.035,
    "base_damping": 0.02,
    "singularity_gain": 0.01,
    "reference_weight": 0.001,
    "joint_limit_margin_rad": 0.05
  },
  "required_outputs": [
    "q_ik_rad_*",
    "ik_converged",
    "ik_iteration_count",
    "ik_position_error_mm",
    "ik_orientation_error_rad",
    "ik_limit_flag",
    "ik_singularity_flag"
  ]
}
